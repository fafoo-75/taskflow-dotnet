@model TaskFlow.Helpers.PaginatedList<TaskFlow.Models.TodoTask>

@{ ViewData["Title"] = "My Tasks"; ViewData["Subtitle"] = "Manage and track your tasks"; }

@* Bouton "+ New Task" injecté dans la topbar via la section *@
@section TopbarActions {
    <a asp-action="Create" class="btn btn-primary">+ New Task</a>
}

@* Filtres *@
<form method="get" class="mb-3 d-flex gap-2 align-items-center flex-wrap">
    <select name="filtre" class="form-select form-select-sm"
            style="width:auto" onchange="this.form.submit()">
        <option value="">All tasks</option>
        <option value="inprogress"
            selected="@(ViewBag.Filtre == "inprogress" ? "selected" : null)">In progress</option>
        <option value="completed"
            selected="@(ViewBag.Filtre == "completed" ? "selected" : null)">Completed</option>
        <option value="high"
            selected="@(ViewBag.Filtre == "high" ? "selected" : null)">High priority</option>
    </select>
    <select name="categoryId" class="form-select form-select-sm"
            style="width:auto" asp-items="ViewBag.Categories"
            onchange="this.form.submit()">
        <option value="">All categories</option>
    </select>
    <input type="text" name="recherche" value="@ViewBag.Recherche"
           class="form-control form-control-sm" style="width:200px"
           placeholder="Search..." />
    <a asp-action="Index" class="btn btn-sm btn-link">Clear</a>
</form>

@if (!Model.Any())
{
    <div style="text-align:center;padding:40px;color:var(--muted)">
        No tasks yet. <a asp-action="Create">Create your first task →</a>
    </div>
}
else
{
    @* Tableau avec les classes CSS de la maquette *@
    <div class="task-table">
        <div class="task-thead">
            <span>Title</span>
            <span>Priority</span>
            <span>Status</span>
            <span>Due Date</span>
            <span></span>
        </div>

        @foreach (var task in Model)
        {
            @* Classe "done" sur la ligne si la tâche est terminée
               → le CSS applique le texte barré *@
            <div class="task-row @(task.EstTerminee ? "done" : "")">

                <div class="task-title-cell">
                    @* Bouton toggle inline *@
                    <form asp-action="ToggleTerminee" asp-route-id="@task.Id"
                          method="post" style="display:contents">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                style="width:16px;height:16px;border:1.5px solid var(--border2);
                                       border-radius:4px;background:@(task.EstTerminee?"var(--green)":"#fff");
                                       color:#fff;cursor:pointer;font-size:10px;flex-shrink:0">
                            @(task.EstTerminee ? "✓" : "")
                        </button>
                    </form>
                    <div style="min-width:0">
                        <div class="task-title">@task.Titre</div>
                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <div class="task-desc">@task.Description</div>
                        }
                    </div>
                </div>

                @* Badge de priorité — classe CSS selon la valeur de l'enum *@
                <div>
                    <span class="badge badge-@task.Priorite.ToString().ToLower()">
                        @task.Priorite
                    </span>
                </div>

                @* Badge de statut — calculé selon IsCompleted et DueDate *@
                <div>
                    @if (task.EstTerminee)
                    {
                        <span class="badge badge-done">Completed</span>
                    }
                    else if (task.DateEcheance < DateTime.Today)
                    {
                        <span class="badge badge-late">Late</span>
                    }
                    else
                    {
                        <span class="badge badge-progress">In Progress</span>
                    }
                </div>

                @* Date avec classe "late" si dépassée *@
                <div class="date-cell @(task.DateEcheance < DateTime.Today && !task.EstTerminee ? "late" : "")">
                    @task.DateEcheance.ToShortDateString()
                </div>

                @* Boutons d'action *@
                <div class="task-actions">
                    <a asp-action="Details" asp-route-id="@task.Id"
                       class="btn btn-sm btn-secondary">View</a>
                    <a asp-action="Edit" asp-route-id="@task.Id"
                       class="btn btn-sm btn-secondary">✏️</a>
                    <a asp-action="Delete" asp-route-id="@task.Id"
                       class="btn btn-sm btn-danger">🗑</a>
                </div>

            </div>
        }
    </div>
}
