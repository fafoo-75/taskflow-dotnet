@model List<TaskFlow.Models.Tag>

@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Mes tags</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nouveau tag</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Aucun tag. Creez votre premier tag !
    </div>
}
else
{
    <div class="list-group">
        @foreach (var tag in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span style="width:14px;height:14px;border-radius:50%;background:@tag.Color;display:inline-block"></span>
                    <span class="fw-medium">@tag.Name</span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@tag.Id"
                       class="btn btn-sm btn-outline-primary">Editer</a>
                    <a asp-action="Delete" asp-route-id="@tag.Id"
                       class="btn btn-sm btn-outline-danger">Supprimer</a>
                </div>
            </div>
        }
    </div>
}
